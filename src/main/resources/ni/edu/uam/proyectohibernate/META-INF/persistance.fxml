<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
    <persistence-unit name="bibliotecaPU" transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        <class>
            org.example.proyectohibernate.model.Libro
        </class>

        <properties>
            <!-- POSTGRESQL -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc.postgresql://localhost:5432/bdbiblioteca"/>
            <property name="jakarta.persistence.jdbc.user" value="josh"/>
            <property name="jakarta.persistence.jdbc.password" value="${DB_PASSWORD_NUHUH}"/>
            <!-- HIBERNATE -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>=
        </properties>
    </persistence-unit>
</persistence>